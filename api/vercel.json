{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60
    },
    "api/admin/*.js": {
      "maxDuration": 60
    },
    "api/pay/*.js": {
      "maxDuration": 60
    },
    "api/stats/*.js": {
      "maxDuration": 60
    },
    "api/logs/*.js": {
      "maxDuration": 60
    },
    "api/automation/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ping",
      "destination": "/api/ping"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ]
}
